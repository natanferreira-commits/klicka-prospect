GOOGLE_MAPS_API_KEY=cole-sua-chave-do-google-cloud-aqui

# Mercado Livre: crie um app em developers.mercadolivre.com.br
# e copie App ID (client id) e Secret Key (client secret).
ML_CLIENT_ID=seu-app-id
ML_CLIENT_SECRET=seu-client-secret
# Precisa bater EXATAMENTE com a Redirect URI cadastrada no app do ML.
ML_REDIRECT_URI=http://localhost:3000/api/ml/callback

# Motor da busca web de contatos: "duckduckgo" (padrao, sem chave) ou "google".
ML_WEBSEARCH=duckduckgo
# So se ML_WEBSEARCH=google. Custom Search JSON API (100 buscas/dia gratis).
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
